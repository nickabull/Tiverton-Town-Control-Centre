    ".trip-hero": "<div class=\"hero-overlay\"><div class=\"hero-top\"><span class=\"pill gold\" id=\"demo-label\">Paulton Rovers · next away trip</span><span class=\"pill glass\">Away day / 2026–27</span></div><div class=\"matchup\"><div><div class=\"hero-eyebrow\">Wednesday 11 November 2026 · 19:45 GMT (home club listing)</div><h2 id=\"fixture-title\">Paulton Rovers <span>v Tiverton Town</span></h2><p>Southern League Division One South</p></div></div><div class=\"hero-bottom\"><div><strong>Winterfield Stadium</strong><span>Winterfield Road, Paulton, Bristol, BS39 7RF</span></div><div class=\"actions\"><a class=\"button yellow\" href=\"https://www.paultonrovers.co.uk/\" target=\"_blank\" rel=\"noopener\">Club website / tickets ↗</a><button class=\"button light\" id=\"calendar\" type=\"button\">Add to calendar</button></div></div></div><div class=\"photo-credit\">Fixture and venue: Paulton Rovers FC official website · <a href=\"https://www.paultonrovers.co.uk/teams/53123/fixtures-results\" target=\"_blank\" rel=\"noopener\">Check fixture ↗</a></div>",
